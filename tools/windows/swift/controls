#!/bin/bash
# controls <dir>: the control gallery (tools/controls/main.swift) built against the AppKit stand-in on the laptop (using
# the stand-ins last built into build\swift-app by `ba -Debug -Out build\swift-app`), run, and fetched into <dir>/win;
# the Mac's into <dir>/mac (tools/controls/run.sh); side-by-side pictures in <dir>/side-light.png, side-dark.png.
set -e
HERE="$(cd "$(dirname "$0")" && pwd)"; export PATH="$HERE/../dev:$PATH"; ROOT="$HERE/../../.."
D="$1"; mkdir -p "$D"
[ -f "$D/mac/controls-dark.png" ] || "$ROOT/tools/controls/run.sh" "$D/mac" >/dev/null
lap sync-wip >/dev/null
lap ps <<'PS' | tr -d '\000\r' | grep -E "error|exit|wrote" | head -20
Set-Location C:\Users\User\Documents\Projects\spider-buddy
$swiftBin = "$env:LOCALAPPDATA\Programs\Swift\Toolchains\6.4.2+Asserts\usr\bin"
$rtBin = "$env:LOCALAPPDATA\Programs\Swift\Runtimes\6.4.2\usr\bin"
$env:SDKROOT = "$env:LOCALAPPDATA\Programs\Swift\Platforms\6.4.2\Windows.platform\Developer\SDKs\Windows.sdk"
$vcvars = 'C:\Program Files (x86)\Microsoft Visual Studio\2022\BuildTools\VC\Auxiliary\Build\vcvars64.bat'
cmd /c "`"$vcvars`" >nul && set" | ForEach-Object { $k, $v = $_ -split '=', 2; if ($k -and $k -notmatch '^(PROMPT|PWD)$') { Set-Item -Path "env:$k" -Value $v } }
$env:PATH = "$swiftBin;$rtBin;$env:PATH"
$o = 'build\swift-app'
& swiftc -O -swift-version 5 -I $o -L $o -lCoreGraphics -lQuartzCore -lAccelerate -lUniformTypeIdentifiers -lAppKit -o "$o\Controls.exe" tools\controls\main.swift 2>&1 | Select-String -Pattern 'error' | Select -First 10 | ForEach-Object { "$_" }
Remove-Item -Recurse -Force out\controls -ErrorAction SilentlyContinue
& "$o\Controls.exe" out\controls 2>&1 | ForEach-Object { "$_" }
"exit $LASTEXITCODE"
PS
rm -rf "$D/win"; mkdir -p "$D/win"
scp -q "laptop:C:/Users/User/Documents/Projects/spider-buddy/out/controls/*" "$D/win/"
python3 - "$D" <<'PY'
import sys
from PIL import Image
D=sys.argv[1]
for n in ("light","dark"):
    m=Image.open(f"{D}/mac/controls-{n}.png").convert("RGB"); w=Image.open(f"{D}/win/controls-{n}.png").convert("RGB")
    W=640; m=m.resize((W, int(m.height*W/m.width))); w=w.resize((W, int(w.height*W/w.width)))
    c=Image.new("RGB",(W, m.height+w.height+6),"red"); c.paste(m,(0,0)); c.paste(w,(0,m.height+6)); c.save(f"{D}/side-{n}.png")
PY
echo "$D/side-light.png $D/side-dark.png"
