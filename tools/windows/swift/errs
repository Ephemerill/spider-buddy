#!/bin/bash
# Exact errors from the last `ba`: file:line message. errs [filter-regex] [count]
grep -a -E '^[^ |].*\.swift:[0-9]+:[0-9]+: error:' /tmp/ba-last.log | sed -E 's/^.*[\\\/]([A-Za-z0-9_]+\.swift:[0-9]+):[0-9]+: error: /\1 /' | grep -a -E "${1:-.}" | awk '!s[$0]++' | cut -c1-${ERR_W:-150} | head -${2:-40}
