#!/bin/bash
# Run build-app on the laptop and print a digest: errors by file and by message. Usage: ba [-Check] [-Opt -Onone]
export PATH="$(dirname "$0")/../dev:$PATH"
LOG=$(mktemp)
lap ps <<PS > "$LOG" 2>&1
Set-Location C:\Users\User\Documents\Projects\spider-buddy
\$t=[Diagnostics.Stopwatch]::StartNew()
powershell -NoProfile -ExecutionPolicy Bypass -File tools\windows\swift\build-app.ps1 $* 2>&1 | ForEach-Object { "\$_" }
"elapsed \$([int]\$t.Elapsed.TotalSeconds)s"
PS
tr -d '\000\r' < "$LOG" > "$LOG.c"; cp "$LOG.c" /tmp/ba-last.log
grep -a -E '(^built|swiftc exit|elapsed|shim .* failed|fatal error|LNK[0-9]+)' "$LOG.c" | grep -a -v '^ *|' | cut -c1-200 | awk '!s[$0]++' | tail -${BA_TAIL:-14}
grep -a -E '^[^ |].*\.swift:[0-9]+:[0-9]+: error:' "$LOG.c" > "$LOG.e"
n=$(wc -l < "$LOG.e"); echo "errors: $n"
if [ "$n" -gt 0 ]; then
  sed -E 's/^.*[\\\/]([A-Za-z0-9_+.-]+\.swift):[0-9]+:[0-9]+: error: (.*)$/\1|\2/' "$LOG.e" | cut -d'|' -f1 | sort | uniq -c | sort -rn | head -${BA_FILES:-12} | awk '{printf "%s(%s) ", $2, $1}'; echo
  sed -E 's/^.*error: //' "$LOG.e" | sed -E "s/^(value of type|type|value of optional type) ('[^']+')/\1 \2/" | sort | uniq -c | sort -rn | head -${BA_SHOW:-60} | cut -c1-${BA_W:-120}
fi
